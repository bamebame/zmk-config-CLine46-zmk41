// CLine46 keymap — Keyball44 (zmk-config-Keyball44) からの移植版。
//
// Keyball44 = 6列/側 x 3段 + 親指 5+3 = 44キー
// CLine46   = 6列/側 x 3段 + 親指 6+4 = 46キー
// 上段3段は 1:1 で対応する。親指は物理 x 座標で対応付けた:
//   CLine46 p37..p41 ← Keyball44 の左親指5キー
//   CLine46 p42,p43,p45 ← Keyball44 の右親指3キー
//   CLine46 p36(左最外), p44(右) は Keyball44 に無い余りキー
// Keyball44 では &none だった外側の列 (p0/p11/p12/p23/p24/p35) は
// CLine46 の割当 (TAB / [ / LCTRL / ] / LSHIFT / RSHIFT) を全レイヤーで活かす。

#define DEFAULT 0
#define NAV     1
#define FUN     2
#define NUM     3
#define BALL    4
#define SCROLL  5

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <180>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <80>;
};

&mt {
    tapping-term-ms = <180>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <80>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    behaviors {
        // === 左親指キー: hold=引数のmod(LCTRL) / 1タップ=無反応 / 2タップ=LC(LSHFT) ===
        // (旧 td_ball。BALL 層とは無関係のため改名)
        td_lctl_inner: td_lctl_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LC(LSHFT)>;
        };
        td_lctl: td_lctl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td_lctl_inner>;
        };

        // === Vial tap-dance 再現 (逆ネスト方式 + quick-tap-ms) ===
        // 外側 hold-tap（hold判定をpress時点で確立 → ホールド+他キー即動作）
        // 内側 tap-dance（tap時に多重押下で2nd-action発動）
        // quick-tap-ms により「タップ→ホールド」も内側で正しく検出

        // --- 内側 tap-dance: tap時の単押し/連打分岐 ---
        td0_inner: td0_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp SPACE>, <&mo FUN>;
        };
        td1_inner: td1_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp SPACE>, <&kp LSHFT>;
        };
        td2_inner: td2_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANG2>, <&kp LCTRL>;
        };
        td3_inner: td3_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANG1>, <&kp LCTRL>;
        };
        td4_inner: td4_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&sk RA(RSHFT)>;
        };
        td5_inner: td5_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp DEL>, <&kp LCTRL>;
        };
        td6_inner: td6_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LSHFT>;
        };
        td7_inner: td7_inner {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LSHFT>;
        };

        // --- 外側 hold-tap: hold-preferred+quick-tap-ms で全機能を両立 ---
        td0: td0 { // hold=MO(layer), tap=td0_inner / 呼出: &td0 NAV 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&td0_inner>;
        };
        td1: td1 { // hold=&kp(mod), tap=td1_inner / 呼出: &td1 LALT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td1_inner>;
        };
        td2: td2 { // 呼出: &td2 FUN 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&td2_inner>;
        };
        td3: td3 { // 呼出: &td3 NUM 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&mo>, <&td3_inner>;
        };
        td4: td4 { // 呼出: &td4 RALT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td4_inner>;
        };
        td5: td5 { // 呼出: &td5 LSHFT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td5_inner>;
        };
        td6: td6 { // 呼出: &td6 LCTRL 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td6_inner>;
        };
        td7: td7 { // 呼出: &td7 LALT 0
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&td7_inner>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // L0: 英字 / 親指: td0=NAV, mt=LSHFT, td3=NUM, td1=LALT
        default_layer {
            display-name = "QWRT";
            bindings = <
&kp TAB             &kp Q               &kp W               &kp E               &kp R               &kp T      &kp Y               &kp U               &kp I               &kp O               &kp P               &kp LEFT_BRACKET
&kp LCTRL           &kp A               &kp S               &kp D               &kp F               &kp G      &kp H               &kp J               &kp K               &kp L               &kp SEMI            &kp RIGHT_BRACKET
&kp LSHIFT          &kp Z               &kp X               &kp C               &kp V               &kp B      &kp N               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &kp RSHIFT
&none               &none               &kp LGUI            &td_lctl LCTRL 0    &td0 NAV 0          &mt LSHFT LANG2      &td3 NUM 0          &td1 LALT 0         &none               &mo SCROLL
            >;
        };

        // L1: ナビ / 音量 / コピペ
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans              &kp Q               &kp W               &kp E               &kp R               &kp T      &kp Y               &kp ENTER           &kp ESC             &kp TAB             &kp END             &trans
&trans              &kp C_VOL_DN        &kp C_VOL_UP        &kp LCTRL           &kp LSHFT           &kp G      &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &kp HOME            &trans
&trans              &kp LC(Z)           &kp LC(X)           &kp LC(C)           &kp LC(V)           &kp ENTER      &kp BSPC            &kp GRAVE           &kp MINUS           &kp EQUAL           &kp BSLH            &trans
&none               &none               &kp LGUI            &trans              &trans              &trans      &td5 LSHFT 0        &td4 RALT 0         &none               &mo SCROLL
            >;
        };

        // L2: F-key / マウスホイール / マウスボタン
        fun_layer {
            display-name = "FUN";
            bindings = <
&trans              &kp F1              &kp F2              &kp F3              &kp F4              &kp F5      &kp F6              &kp F7              &kp F8              &kp F9              &kp F10             &trans
&trans              &kp F11             &kp F12             &kp LCTRL           &kp LSHFT           &kp F16      &kp H               &kp J               &kp K               &kp LBKT            &kp RBKT            &trans
&trans              &kp LC(Z)           &kp LC(X)           &kp LC(C)           &kp LC(V)           &kp LC(B)      &kp N               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &trans
&none               &none               &kp LGUI            &trans              &trans              &trans      &td5 LSHFT 0        &td4 RALT 0         &none               &trans
            >;
        };

        // L3: 数字行 / td7=&kp LALT
        num_layer {
            display-name = "NUM";
            bindings = <
&trans              &kp N1              &kp N2              &kp N3              &kp N4              &kp N5      &kp N6              &kp N7              &kp N8              &kp N9              &kp N0              &trans
&trans              &kp A               &kp S               &kp D               &kp F               &kp G      &kp H               &kp J               &kp SQT             &kp LBKT            &kp RBKT            &trans
&trans              &kp Z               &kp X               &kp C               &kp V               &kp B      &kp N               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &trans
&none               &none               &kp LGUI            &trans              &td7 LALT 0         &kp LSHFT      &trans              &trans              &none               &trans
            >;
        };

        // L4: BALL (マウスボタン / スクロール起動) — ボール移動で自動的に入る
        ball_layer {
            display-name = "BALL";
            bindings = <
&trans              &none               &none               &none               &none               &none      &kp LC(W)           &mkp MCLK           &mkp MB4            &mkp MB5            &none               &trans
&trans              &none               &none               &trans              &trans              &trans      &kp LEFT            &mkp LCLK           &mkp RCLK           &kp RIGHT           &none               &trans
&trans              &none               &none               &none               &none               &none      &mo SCROLL          &msc SCRL_DOWN      &msc SCRL_UP        &kp LCTRL           &none               &trans
&none               &none               &none               &trans              &trans              &trans      &none               &none               &none               &none
            >;
        };

        // L5: SCROLL (BT/出力切替 / 方向スクロール / bootloader / studio unlock)
        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&studio_unlock      &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &bt BT_SEL 3        &bt BT_SEL 4      &out OUT_TOG        &trans              &mkp MB4            &mkp MB5            &trans              &trans
&trans              &bt BT_CLR          &trans              &kp LCTRL           &kp LSHFT           &kp F16      &kp LEFT            &mkp LCLK           &mkp RCLK           &kp RIGHT           &trans              &trans
&trans              &trans              &trans              &trans              &trans              &trans      &trans              &trans              &trans              &trans              &trans              &trans
&bootloader         &trans              &trans              &trans              &td7 LALT 0         &td6 LCTRL 0      &trans              &trans              &bootloader         &trans
            >;
        };
    };
};
